# Cicero Grand — environment variables
# Copy to .env for local development. In Railway, set these in the
# project's "Variables" tab (do NOT commit .env).

# ---------------------------------------------------------------
# Required for production
# ---------------------------------------------------------------

# Password for the /admin login page. Pick something strong.
ADMIN_PASSWORD=cicero-admin

# 32+ character random string used to sign auth cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-or-more-chars

# Where contact-form submissions are routed (only used in logs today;
# wire up an SMTP/Mailchimp transport here later if you want email).
SALES_EMAIL=sales@sundhm.com

# ---------------------------------------------------------------
# Production paths (Railway with a persistent volume mounted at /data)
# ---------------------------------------------------------------
# Leave these unset locally — defaults to ./uploads and ./data.db.
# In Railway, mount a volume at /data and set:
#   UPLOAD_DIR=/data/uploads
#   DATABASE_PATH=/data/data.db
UPLOAD_DIR=/data/uploads
DATABASE_PATH=/data/data.db

# Port the Express server listens on. Railway injects PORT automatically.
PORT=5000
